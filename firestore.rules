rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOfficialAttemptSubmission() {
      return request.resource.data.keys().hasAll([
          'schemaVersion',
          'questionSetVersion',
          'answerMap',
          'clientCompletedAt',
          'submittedAtClient'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'questionSetVersion',
          'answerMap',
          'clientCompletedAt',
          'submittedAtClient'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.questionSetVersion is string
        && request.resource.data.answerMap is map
        && (
          (request.resource.data.questionSetVersion.matches('^editorial-simulado-[0-9a-f]{16}$')
            && request.resource.data.answerMap.size() == 20)
          ||
          (request.resource.data.questionSetVersion.matches('^editorial-corpus-[0-9a-f]{16}$')
            && request.resource.data.answerMap.size() == 10)
        )
        && request.resource.data.clientCompletedAt is string
        && request.resource.data.submittedAtClient is string;
    }

    function isDuelSubmission() {
      return request.resource.data.keys().hasAll([
          'schemaVersion',
          'questionSetVersion',
          'answerLog',
          'clientFinishedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'questionSetVersion',
          'answerLog',
          'clientFinishedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.questionSetVersion is string
        && request.resource.data.questionSetVersion.matches('^editorial-duel-[0-9a-f]{16}$')
        && request.resource.data.answerLog is list
        && request.resource.data.answerLog.size() <= 12
        && request.resource.data.clientFinishedAt is string;
    }

    match /users/{userId} {
      // Basic profile and server activity timestamp.
      allow read, create, update, delete: if isOwner(userId);

      // All private preference/state documents used by the study UI.
      match /data/{documentId} {
        allow read, write: if isOwner(userId);
      }

      match /module_notes/{moduleId} {
        allow read, write: if isOwner(userId);
      }

      // FCM tokens are private and can only be changed by their owner.
      match /push_subscriptions/{tokenHash} {
        allow read, write: if isOwner(userId);
      }

      // A client can create one immutable answer-map submission. A Cloud
      // Function recomputes the score and writes the verified result.
      match /attempt_submissions/{attemptId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isOfficialAttemptSubmission();
        allow update, delete: if false;
      }

      // Never trust a browser to create or edit a validated result.
      match /verified_attempts/{attemptId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // As with simulations, the browser sends only a transcript. Public Duel
      // aggregates are authored by Firebase Admin after verification.
      match /duel_submissions/{roundId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isDuelSubmission();
        allow update, delete: if false;
      }

      match /verified_duel_rounds/{roundId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Legacy root collections retained for existing installations.
    match /caderno_erros/{errorId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /study_checklist/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Public entries are generated by Firebase Admin after score validation.
    // Admin SDK bypasses rules; no browser receives a write permission here.
    match /leaderboards/{monthId}/entries/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Duel aggregates follow the same server-verified path.
    match /duel_leaderboards/{monthId}/entries/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
